#!/usr/bin/env bash
# Pre-push gate: formatting, lints, and tests must pass before anything leaves the machine.
# Activated via `git config core.hooksPath .githooks` (run once after cloning).
set -euo pipefail

echo "[pre-push] cargo fmt --check"
cargo fmt --all --check

echo "[pre-push] cargo clippy (warnings = errors)"
cargo clippy --workspace --all-targets -- -D warnings

echo "[pre-push] semgrep (.semgrep/ — repo conventions + reuse rules)"
if poetry env info --path >/dev/null 2>&1; then
    poetry run semgrep --config .semgrep/ --error --metrics=off --quiet .
else
    echo "  skipped: no poetry env — run \`just semgrep-setup\` to enable this gate"
fi

echo "[pre-push] cargo test"
cargo test --workspace

echo "[pre-push] ok"
