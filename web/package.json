{
  "name": "rlt-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/rlt-wasm --target web --out-dir pkg -- --no-default-features",
    "stage": "node scripts/stage-artifacts.mjs",
    "stage:all": "node scripts/stage-artifacts.mjs all",
    "prebuild": "pnpm run wasm && pnpm run stage:all",
    "predev": "pnpm run wasm && pnpm run stage",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^73.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.26",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "monaco-editor": "^0.56.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
    "overrides": {
      "dompurify": "^3.4.11",
      "cookie": "^0.7.0"
    }
  }
}
