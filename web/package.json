{
  "name": "rlt-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/rlt-wasm --target web --out-dir pkg -- --no-default-features",
    "stage": "node scripts/stage-artifacts.mjs",
    "stage:all": "node scripts/stage-artifacts.mjs all",
    "prebuild": "pnpm run wasm && pnpm run stage:all",
    "predev": "pnpm run wasm && pnpm run stage",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.28",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-eslint-parser": "^1.8.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "monaco-editor": "^0.57.0"
  }
}
